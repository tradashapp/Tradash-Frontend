# --- Privy (wallet connect / master-account auth) ---
NEXT_PUBLIC_PRIVY_APP_ID=

# --- Bulk Exchange ---
NEXT_PUBLIC_BULK_REST_URL=https://exchange-api.bulk.trade/api/v1
NEXT_PUBLIC_BULK_ACCOUNT_WS_URL=wss://exchange-ws1.bulk.trade
# devnet | testnet (both faucet-funded) | mainnet (USDC deposit funding).
# MUST match the network BULK_REST_URL points at: since Bulk v1.0.17 this also
# selects the signature domain that every signed tx is bound to (mainnet 1,
# testnet 2, devnet 3). A mismatch fails as an opaque `bad signature`.
NEXT_PUBLIC_BULK_NETWORK=testnet

# --- Builder codes (our revenue) ---
# Recipient pubkey that collects our builder fee, and the fee in basis points (1-15).
NEXT_PUBLIC_BUILDER_RECIPIENT=
NEXT_PUBLIC_BUILDER_FEE_BPS=

# --- MagicBlock oracle ---
# Router resolves the ER RPC endpoint via getDelegationStatus; we accountSubscribe there.
NEXT_PUBLIC_MAGICBLOCK_ROUTER_URL=https://devnet-router.magicblock.app
NEXT_PUBLIC_SOLANA_RPC_URL=https://rpc.magicblock.app/devnet

# --- Our backend ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Execution venue ---
# Defaults to PHOENIX. Set to "bulk" to roll back to the old venue; any other
# value (or unset) uses Phoenix.
# NOTE: Phoenix has no native trailing stop — placing one throws rather than
# silently arming nothing. Stay on bulk if you need trailing stops.
# NEXT_PUBLIC_VENUE=phoenix
