# Tradash — PRODUCTION (Bulk mainnet, real funds).
#
# Copy to your host's env (Vercel/Netlify project settings), NOT into git.
# Every value here is baked into the client bundle at build time, so a change
# needs a REDEPLOY, not just a restart.

# --- Privy ---
NEXT_PUBLIC_PRIVY_APP_ID=

# --- Bulk Exchange (MAINNET) ---
# Verified live 2026-09-11: /account returns a real account, WS handshake 101.
NEXT_PUBLIC_BULK_REST_URL=https://mainnet-api1.bulk.trade/api/v1
NEXT_PUBLIC_BULK_ACCOUNT_WS_URL=wss://mainnet-ws1.bulk.trade
# Selects the SIGNATURE DOMAIN every signed tx is bound to (mainnet 1). Must
# match the network the REST URL points at, or every order, agent authorization
# and deposit fails as an opaque `bad signature`.
NEXT_PUBLIC_BULK_NETWORK=mainnet

# --- Builder codes (revenue) ---
NEXT_PUBLIC_BUILDER_RECIPIENT=AUNDCuraztXWaaNMWJrRxe6rgGDikwpfkWLPhs1xfxWn
NEXT_PUBLIC_BUILDER_FEE_BPS=5

# --- MagicBlock oracle (CHART PRICES ONLY — stays DEVNET on purpose) ---
# Read-only Pyth-Lazer feeds, identical on devnet and mainnet, and nothing here
# signs or touches funds. Devnet needs no API key; mainnet does.
NEXT_PUBLIC_MAGICBLOCK_ER_URL=https://devnet.magicblock.app
NEXT_PUBLIC_MAGICBLOCK_ROUTER_URL=https://devnet-router.magicblock.app
NEXT_PUBLIC_MAGICBLOCK_RPC_URL=https://rpc.magicblock.app/devnet

# --- Solana RPC for REAL-MONEY reads (wallet USDC / deposits) ---
# MUST be a keyed MAINNET RPC (Helius / Triton / QuickNode).
# SILENT FAILURE: the mainnet USDC mint also resolves to an unrelated devnet
# account, so a devnet URL here does NOT error — every wallet reads $0 and
# deposits become impossible, with nothing logged.
NEXT_PUBLIC_SOLANA_RPC_URL=

# --- Our backend ---
NEXT_PUBLIC_API_URL=https://api.tradash.xyz
NEXT_PUBLIC_APP_URL=https://tradash.xyz
